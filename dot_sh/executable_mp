#!/usr/bin/env zsh

! (( ${+MPC_FORMAT} )) && source ~/.env/MPC_FORMAT &>/dev/null
! (( ${+FZF_DEFAULT_OPTS} )) && source ~/.env/FZF_DEFAULT_OPTS &>/dev/null
! (( ${+USR_MUSIC_DIR} )) && source ~/.env/USR_MUSIC_DIR &>/dev/null

cmd=("$@")

insert=0
keep=0
queue=0
blocks=0
noclear=0
playlist=0

psleep='0.1'

banner() {
	echo
	echo " █████████████   ████████"
	echo "▒▒███▒▒███▒▒███ ▒▒███▒▒███"
	echo " ▒███ ▒███ ▒███  ▒███ ▒███"
	echo " ▒███ ▒███ ▒███  ▒███ ▒███"
	echo " █████▒███ █████ ▒███████"
	echo "▒▒▒▒▒ ▒▒▒ ▒▒▒▒▒  ▒███▒▒▒"
	echo "                 ▒███"
	echo "                 █████"
	echo "                ▒▒▒▒▒"
	echo
}

DEPS=('mpc' 'fzf' 'chafa' 'ffmpeg' 'exiftool')
for dep in $DEPS; do whence $dep &>/dev/null || { echo -e "[mp!] mp relies on $dep\n[mp/] aborting"; exit 1 }; done

export MP_MUSDIR="${USR_MUSIC_DIR:-$XDG_MUSIC_DIR}"

### parsing

flg=()
flgraw=()
prs-flg() {
	case "$1" in
		"h" | "help") flg+=("HELP") ;;
		"b" | "blocks") flg+=("BLOCKS") ;;
		"d" | "no-clear") flg+=("NOCLEAR") ;;
		"p" | "playlist") flg+=("PLAYLIST") ;;
		*) flg+=("unknown") ;;
	esac
}

for i in {1..$#cmd}; do
	if [[ ${cmd[$i]:0:1} == "-" ]]; then
		if [[ ! ${cmd[$i]:1:1} == '-' ]]; then
			for o in $(print -rl -- ${(s::)cmd[$i]:1}); do
				flgraw+=("$o")
				prs-flg "$o"
			done
		else
			flgraw+=("${cmd[$i]:1}")
			prs-flg "${cmd[$i]:2}"
		fi
		unset "cmd[$i]"
	fi
done

cmd=($cmd)

if [ $#flg -eq 0 ]; then
	flg=("none")
fi

for i in {1..$#flg}; do
	case "${flg[$i]}" in
		"none") ;;
		"unknown")
			echo "[mp!] unknown flag [ -${flgraw[$i]} ]"
			echo "[mp/] aborting"
			exit 1
			;;
		"HELP")
			banner
			echo "[.] usage: mp [-options]"
			echo "[.] -b | --blocks"
			echo "[,]    renders using blocks instead of"
			echo "[,]    kitty's icat functionality"
			echo "[.] -d | --no-clear"
			echo "[,]    does not clear fzf's tui"
			echo "[.] -p | --playlist"
			echo "[,]    selects playlists instead of songs"
			echo "[.] -h | --help"
			echo "[,]    prints this message"
			echo "[ ]"
			echo "[.] this program sources environment vars"
			echo "[,] from \$HOME/.env/, including MPC_FORMAT,"
			echo "[,] FZF_DEFAULT_OPTS, and USR_MUSIC_DIR;"
			echo "[,] file names are that of the variables"
			echo "[,] and consist of a single export VAR=''"
			echo "[ ]"
			echo "[.] to queue up songs press"
			echo "[,] ctrl/alt + space/backspace, press f1 to"
			echo "[,] reload the song database, f2 load a"
			echo "[,] shuffled database, f3 to search files"
			echo "[,] instead of song names, and f4 to crop"
			echo "[,] the song queue"
			echo
			exit 0
			;;
		"BLOCKS") blocks=1 ;;
		"NOCLEAR") noclear=1 ;;
		"PLAYLIST") playlist=1 ;;
		*)
			echo "[mp!] catastrophic error while parsing flags"
			echo "[mp/] aborting"
			exit 1
			;;
	esac
done

### main

if ! [ $noclear -eq 1 ]; then
	cls='--clear'
else
	cls='--no-clear'
fi

# playlist logic
if [ $playlist -eq 1 ]; then
	prevwin='top,50%'
	binds='ctrl-o:select-all,ctrl-x:deselect-all,ctrl-n:toggle-all,enter:print(//MPMOD:CLEAR)+accept,ctrl-space:print(//MPMOD:TAILP)+accept,alt-space:print(//MPMOD:NEXTP)+accept,ctrl-bs:print(//MPMOD:TAILQ)+accept,alt-bs:print(//MPMOD:NEXTQ)+accept'
	
	mpl=$(mpc lsplaylists|fzf --gap --gap-line='─' --preview 'mpc playlist {}' --preview-window="$prevwin" "$cls" --bind "$binds" --query "$cmd")
	
	mpla=( ${(f)mpl} )
	
	for i in {1..$#mpla}; do
		if [[ ${mpla[$i][1,8]} == "//MPMOD:" ]]; then
			case "${mpla[$i]:8}" in
				"TAILP" | "NEXTP") keep=1; queue=0; mpla[$i]=() ;;
				"TAILQ" | "NEXTQ") keep=1; queue=1; mpla[$i]=() ;;
				"CLEAR") keep=0; queue=0; mpla[$i]=() ;;
				*) ;;
			esac
		fi
	done
	
	if ! [[ -z $mpl ]]; then
		qs=$(mpc playlist|wc -l)
		if ! [ $keep -eq 1 ]; then mpc -q clear; fi
		for i in $mpla; do mpc -q load "$i" > /dev/null; done
		if ! [ $queue -eq 1 ]; then
			if ! [ $keep -eq 1 ]; then
				sleep $psleep
				mpc -q play
			else
				mpc -q play $(( qs + 1 ))
			fi
		fi
	fi
	
	exit 0
fi

# non-playlist

exif_grab='exiftool -Picture -q -q -b $MP_MUSDIR/{1}'
ffmpeg_grab='ffmpeg -loglevel quiet -i file:$MP_MUSDIR/{1} -an -c:v copy -f image2pipe -'
mpc_grab='mpc readpicture {1}'

sp_chafa_img='chafa - -f symbols --animate=off --stretch --size=${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}'

kp_chafa_img='chafa - -f kitty --animate=off --threshold 1.0 --bg black --stretch --size=$(( FZF_PREVIEW_COLUMNS < FZF_PREVIEW_LINES * 2 ? FZF_PREVIEW_COLUMNS : (FZF_PREVIEW_LINES * 3 > FZF_PREVIEW_COLUMNS ? FZF_PREVIEW_COLUMNS : FZF_PREVIEW_LINES * 2) ))x${FZF_PREVIEW_LINES}'
kp_txt_prefx='%$(( FZF_PREVIEW_LINES * 2 ))s \\033[0;90m▌'
kp_txt_col0='\\033[0m'
kp_txt_col1='\\033[1;32m'
kp_txt_col2='\\033[1;31m'

kittyprev="printf \"${kp_txt_prefx} ${kp_txt_col1}TITLE:${kp_txt_col0} \$(mpc -f %title% find filename {1})\" && { ${exif_grab} || ${ffmpeg_grab} || ${mpc_grab} } | ${kp_chafa_img} 2>/dev/null || echo && printf \"${kp_txt_prefx} ${kp_txt_col1}ARTIST:${kp_txt_col0} \$(mpc -f %artist% find filename {1})\\\n${kp_txt_prefx} ${kp_txt_col1}ALBUMARTIST:${kp_txt_col0} \$(mpc -f %albumartist% find filename {1})\\\n${kp_txt_prefx} ${kp_txt_col1}ALBUM:${kp_txt_col0} \$(mpc -f %album% find filename {1})\\\n${kp_txt_prefx} ${kp_txt_col1}YEAR:${kp_txt_col0} \$(mpc -f %date% find filename {1})\\\n${kp_txt_prefx} ${kp_txt_col1}TRACK:${kp_txt_col0} \$(mpc -f '[%disc%-]%track%' find filename {1})\\\n${kp_txt_prefx} ${kp_txt_col1}DURATION:${kp_txt_col0} \$(mpc -f %time% find filename {1})\\\n${kp_txt_prefx} \\\n${kp_txt_prefx} ${kp_txt_col2}FILE:${kp_txt_col0} {1}\\\n${kp_txt_prefx} ${kp_txt_col2}MODIFIED:${kp_txt_col0} \$(mpc -f %mtime% find filename {1})\\\n${kp_txt_prefx} ${kp_txt_col2}FORMAT:${kp_txt_col0} \$(mpc -f %audioformat% find filename {1})\""

symbolsprev="{ ${exif_grab} || ${ffmpeg_grab} || ${mpc_grab} } | ${sp_chafa_img} 2>/dev/null || echo"

binds='ctrl-l:execute(clear),ctrl-o:select-all,ctrl-x:deselect-all,ctrl-n:toggle-all,f1:reload(mpc listall -f %file%\\t$MPC_FORMAT)+change-preview-label(),f2:reload(mpc listall -f %file%\\t$MPC_FORMAT|shuf)+change-preview-label([ SHUF ]),f3:change-with-nth(1|2),f4:execute-silent(mpc -q crop),enter:print(//MPMOD:CLEAR)+accept,ctrl-space:print(//MPMOD:TAILP)+accept,alt-space:print(//MPMOD:NEXTP)+accept,ctrl-bs:print(//MPMOD:TAILQ)+accept,alt-bs:print(//MPMOD:NEXTQ)+accept'

prevwin='top,50%'

if ! [ $blocks -eq 1 ]; then
	mp=$(mpc listall -f %file%\\t"$MPC_FORMAT"|fzf +s -d "\t" --with-nth 2 --accept-nth 1 --preview "$kittyprev" --preview-window="$prevwin" "$cls" --bind "$binds" --query "$cmd")
else
	mp=$(mpc listall -f %file%\\t"$MPC_FORMAT"|fzf +s -d "\t" --with-nth 2 --accept-nth 1 --preview "$symbolsprev" --preview-window="$prevwin" "$cls" --bind "$binds" --query "$cmd")
fi

mpa=( ${(f)mp} )

for i in {1..$#mpa}; do
	if [[ ${mpa[$i][1,8]} == "//MPMOD:" ]]; then
		case "${mpa[$i]:8}" in
			"TAILP") keep=1; insert=0; queue=0; mpa[$i]=() ;;
			"NEXTP") keep=1; insert=1; queue=0; mpa[$i]=() ;;
			"TAILQ") keep=1; insert=0; queue=1; mpa[$i]=() ;;
			"NEXTQ") keep=1; insert=1; queue=1; mpa[$i]=() ;;
			"CLEAR") keep=0; insert=0; queue=0; mpa[$i]=() ;;
			*) ;;
		esac
	fi
done

if ! [[ -z $mp ]]; then
	qs=$(mpc playlist|wc -l)
	if ! [ $keep -eq 1 ]; then mpc -q clear; fi
	if ! [ $insert -eq 1 ]; then
		for i in $mpa; do mpc -q add "$i"; done
	else
		for i in $mpa; do mpc -q insert "$i"; done
	fi
	if ! [ $queue -eq 1 ]; then
		if ! [ $keep -eq 1 ]; then
			sleep $psleep
			mpc -q play
		else
			if ! [ $insert -eq 1 ]; then
				mpc -q play $(( qs + 1 ))
			else
				mpc -q next
			fi
		fi
	fi
fi

exit 0
